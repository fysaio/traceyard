{
  "name": "traceyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run the test that shows what broke and check your fix against it.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config dist/worker/wrangler.json",
    "build:managed": "npm run typecheck && vite build --mode managed",
    "dev:managed": "vite --mode managed",
    "typecheck": "npm run cf:typegen && tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest --project unit",
    "db:migrate:local": "wrangler d1 migrations apply traceyard-prod-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply traceyard-prod-db --remote",
    "db:list:local": "wrangler d1 migrations list traceyard-prod-db --local",
    "cf:typegen": "wrangler types",
    "bench:api": "node scripts/bench-api.mjs",
    "dev:acceptance": "vite --mode acceptance",
    "db:migrate:acceptance": "wrangler d1 migrations apply traceyard-acceptance-db --config wrangler.acceptance.jsonc --local",
    "predev": "npm run db:migrate:local",
    "predev:acceptance": "npm run db:migrate:acceptance",
    "deploy:managed": "npm run build:managed && wrangler deploy --config dist/worker/wrangler.json",
    "configure:cloudflare": "node scripts/configure-cloudflare.mjs",
    "bench:cli": "node scripts/bench-cli.mjs",
    "bench:investigation": "node scripts/bench-investigation.mjs",
    "deploy:investigations": "node scripts/deploy-investigations.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.14",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "bin": {
    "traceyard": "agent/cli.mjs"
  }
}
