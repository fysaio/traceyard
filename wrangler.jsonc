{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "traceyard",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-13",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/oauth/*", "/.well-known/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "traceyard-prod-db",
      "database_id": "cae223eb-3992-40dc-b04d-d3d2946a6e1e",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "name": "traceyard-repository-discovery",
      "binding": "REPOSITORY_DISCOVERY",
      "class_name": "RepositoryDiscoveryWorkflow",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "SOURCE_SCAN_FILE_LIMIT": "16",
    "SOURCE_SCAN_FILE_BYTES": "16000",
  },
}
