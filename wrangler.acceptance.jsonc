// Local browser acceptance only. Never use this config to deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "traceyard-local-acceptance",
  "main": "./tests/browser/fixture-worker.ts",
  "compatibility_date": "2026-11-13",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__acceptance/*", "/mcp", "/oauth/*", "/.well-known/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "traceyard-acceptance-db",
      "database_id": "00000000-0000-0000-0000-000000000007",
      "migrations_dir": "migrations",
    },
  ],
  "workflows": [
    {
      "name": "traceyard-repository-discovery-acceptance",
      "binding": "REPOSITORY_DISCOVERY",
      "class_name": "RepositoryDiscoveryWorkflow",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "vars": {
    "APP_VERSION": "0.1.0",
    "LOCAL_ACCEPTANCE": "true",
    "PUBLIC_APP_ORIGIN": "https://traceyard-acceptance.example.test",
  },
}
